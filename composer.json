{
    "name": "substancephp/http",
    "description": "An HTTP request handling library for modern PHP",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "SubstancePHP\\HTTP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SubstancePHP\\HTTP\\": "src/",
            "Test\\": "test",
            "TestUtil\\": "testutil"
        }
    },
    "authors": [
        {
            "name": "Matthew Harvey",
            "email": "software@matthewharvey.net"
        }
    ],
    "keywords": [
      "HTTP",
      "router"
    ],
    "homepage": "https://github.com/substancephp/http",
    "require": {
        "php": ">=8.4",
        "laminas/laminas-diactoros": "^3.8",
        "laminas/laminas-httphandlerrunner": "^2.13",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "substancephp/container": "^0.6.2",
        "psr/log": "^3.0",
        "laminas/laminas-escaper": "^2.18",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "phpunit/phpunit": "^12.1",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "minimum-stability": "stable",
    "scripts": {
        "qa": ["@lint", "@stan", "@test"],
        "lint": "vendor/bin/php-cs-fixer check",
        "delint": "vendor/bin/php-cs-fixer fix",
        "stan": "vendor/bin/phpstan analyse --level=8 --memory-limit=1G src test testutil",
        "test": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-text test",
        "serve-coverage-report": "php -S localhost:3000 -t html-coverage"
    },
    "scripts-descriptions": {
      "qa": "Run all the code quality checks; don't auto-fix anything",
      "lint": "Check for lint",
      "delint": "De-lint",
      "stan": "Run static analysis",
      "test": "Run the tests",
      "serve-coverage-report": "Serve an HTML code coverage report"
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "support": {
        "issues": "https://github.com/substancephp/http/issues",
        "source": "https://github.com/substancephp/http"
    }
}
