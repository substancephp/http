# PHPStan extension for substancephp/http
#
# Include this file from your project's phpstan.neon to make PHPStan flag
# unescaped (XSS-prone) output in your HTML templates:
#
#   includes:
#       - vendor/substancephp/http/extension.neon
#
# If you use phpstan/extension-installer, the extension is registered
# automatically and you do not need the includes entry.
#
# This file only registers rules and collectors; it does not change the
# analysis level, paths or any other PHPStan settings. See
# docs/static-analysis.md for what the rules report.

services:
    -
        class: SubstancePHP\HTTP\PHPStan\UnescapedOutputRule
        tags:
            - phpstan.rules.rule
    -
        class: SubstancePHP\HTTP\PHPStan\UnescapedPrintRule
        tags:
            - phpstan.rules.rule
    -
        class: SubstancePHP\HTTP\PHPStan\UnescapedExitRule
        tags:
            - phpstan.rules.rule
    -
        class: SubstancePHP\HTTP\PHPStan\UnescapedOutputFuncCallRule
        tags:
            - phpstan.rules.rule
    -
        class: SubstancePHP\HTTP\PHPStan\TemplateVariablesCollector
        tags:
            - phpstan.collector
    -
        class: SubstancePHP\HTTP\PHPStan\ActionDataCollector
        tags:
            - phpstan.collector
    -
        class: SubstancePHP\HTTP\PHPStan\ShareCollector
        tags:
            - phpstan.collector
    -
        class: SubstancePHP\HTTP\PHPStan\TemplateSelectionCollector
        tags:
            - phpstan.collector
    -
        class: SubstancePHP\HTTP\PHPStan\TemplateSetCollector
        tags:
            - phpstan.collector
    -
        class: SubstancePHP\HTTP\PHPStan\TemplateVariablesRule
        tags:
            - phpstan.rules.rule
